# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# Node reads this file automatically when you start the server with
# `node --env-file=.env ...` (see the npm scripts).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Public origin, used to build Stripe return URLs and for server-side rendering.
# Must match the address customers actually use, including https:// in production.
SITE_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Payments (Stripe)
# ---------------------------------------------------------------------------
#
# Leave STRIPE_SECRET_KEY blank to run with a simulated checkout: orders are
# recorded and no card is charged. The site says so plainly when it is in this
# mode. Fill it in to take real payments.
#
# Test keys start with sk_test_ and live keys with sk_live_. Get them from
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:4000/api/stripe/webhook` in
# development, or from the webhook endpoint you create in the Stripe dashboard
# in production. Points at POST /api/stripe/webhook and listens for
# checkout.session.completed.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Store settings
# ---------------------------------------------------------------------------

CURRENCY=usd

# Amounts in integer cents. 495 = $4.95 flat shipping, free over $35.00.
SHIPPING_CENTS=495
FREE_SHIPPING_THRESHOLD_CENTS=3500

# Where the SQLite file lives. Put this on a persistent volume in production.
DATABASE_PATH=data/heartdog.db

# ---------------------------------------------------------------------------
# Charity featured on the donation page
# ---------------------------------------------------------------------------
#
# Replace these with the rescue you want to support. The donate page links out
# to CHARITY_DONATE_URL — no money passes through this site.

CHARITY_NAME=Your Local Dog Rescue
CHARITY_TAGLINE=Second chances for dogs waiting on their people.
CHARITY_DONATE_URL=https://example.org/donate
CHARITY_SITE_URL=https://example.org

# Optional. Shown on the donate page if set.
CHARITY_EIN=
